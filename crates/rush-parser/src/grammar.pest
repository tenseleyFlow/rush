// Rush shell grammar (Phase 4 - Control Flow)

// Explicit whitespace handling (no automatic whitespace insertion)
ws = _{ " " | "\t" }
line_comment = _{ "#" ~ (!NEWLINE ~ ANY)* }

// Top-level input
trailing_sep = _{ (NEWLINE | ";")* }
input = { SOI ~ ws* ~ command_line ~ ws* ~ trailing_sep ~ ws* ~ EOI }

// Command line: can be multiple complete commands separated by newlines/semicolons
command_line = { (complete_command ~ (separator ~ complete_command)* ~ separator?)? }

// Complete command: can be a compound command or an and_or list
// Can optionally be run in background with &
// Don't try to parse closing keywords as commands
complete_command = {
    (function_definition
    | if_statement
    | while_statement
    | for_statement
    | case_statement
    | !closing_keyword ~ and_or_list)
    ~ background_marker?
}

// Background execution marker
background_marker = { ws* ~ "&" }

// Closing keywords that end control flow blocks
// Note: ";;" is for case clauses
closing_keyword = @{ (";;" | "fi" | "done" | "esac" | "elif" | "else") ~ &(ws | NEWLINE | ";" | EOI) }

// And/Or list: pipelines connected by && or ||
and_or_list = { pipeline ~ (ws* ~ and_or_op ~ ws* ~ pipeline)* }
and_or_op = { "&&" | "||" }

// Pipeline: commands connected by pipes
pipeline = { simple_command ~ (ws* ~ "|" ~ ws* ~ simple_command)* }

// Control flow statements
// Keywords must be followed by whitespace, separator, or EOI (not word characters)
keyword_boundary = _{ &(ws | NEWLINE | ";" | EOI) }

if_statement = {
    "if" ~ keyword_boundary ~ separator ~ complete_command ~ separator ~ "then" ~ keyword_boundary ~ separator ~ command_list ~ separator?
    ~ elif_clause*
    ~ else_clause?
    ~ "fi" ~ keyword_boundary
}

elif_clause = {
    "elif" ~ keyword_boundary ~ separator ~ complete_command ~ separator ~ "then" ~ keyword_boundary ~ separator ~ command_list ~ separator?
}

else_clause = {
    "else" ~ keyword_boundary ~ separator ~ command_list ~ separator?
}

while_statement = {
    "while" ~ keyword_boundary ~ separator ~ complete_command ~ separator ~ "do" ~ keyword_boundary ~ separator ~ command_list ~ separator? ~ "done" ~ keyword_boundary
}

for_statement = {
    "for" ~ keyword_boundary ~ ws+ ~ var_name ~ ws+ ~ "in" ~ keyword_boundary ~ (ws+ ~ word)* ~ separator ~ "do" ~ keyword_boundary ~ separator ~ command_list ~ separator? ~ "done" ~ keyword_boundary
}

case_statement = {
    "case" ~ keyword_boundary ~ ws+ ~ word ~ ws+ ~ "in" ~ keyword_boundary ~ separator ~ case_clause* ~ "esac" ~ keyword_boundary
}

case_clause = {
    ws* ~ pattern ~ (ws* ~ "|" ~ ws* ~ pattern)* ~ ws* ~ ")" ~ separator ~ command_list ~ (NEWLINE | ws)* ~ ";;" ~ separator?
}

pattern = { word }

// Function definition: function name { body; } or name() { body; }
function_definition = {
    "function" ~ keyword_boundary ~ ws+ ~ function_name ~ separator? ~ "{" ~ separator ~ command_list ~ separator? ~ "}"
    | function_name ~ ws* ~ "(" ~ ws* ~ ")" ~ separator? ~ "{" ~ separator ~ command_list ~ separator? ~ "}"
}

function_name = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Command list: one or more complete commands separated by newlines or semicolons
command_list = { complete_command ~ (separator ~ complete_command)* }

// Separator: newlines, semicolons, or whitespace
// Don't match ";;" as it's used in case statements
separator = _{ (ws* ~ (NEWLINE | (";" ~ !";")) ~ ws*)+ | ws+ }

// Simple command: assignments and/or words, with optional redirections
// Assignments must come before words (bash convention)
// Redirects can appear anywhere after words, and must be tried before words to capture fd numbers
simple_command = {
    assignment ~ (ws+ ~ assignment)* ~ (ws+ ~ word ~ (ws+ ~ (redirect | word))*)? ~ (ws* ~ redirect)*
    | word ~ (ws+ ~ (redirect | word))* ~ (ws* ~ redirect)*
    | redirect ~ (ws* ~ redirect)*
}

// Variable assignment: NAME=value
assignment = { var_name ~ "=" ~ word }
var_name = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Redirections: <file, >file, >>file, 2>file, 2>&1, &>file, <<EOF, <<<string
redirect = {
    redirect_stderr_to_stdout  // Must come before others to match 2>&1
    | redirect_all_output       // &>file or &>>file
    | redirect_herestring       // <<<string (must come before heredoc)
    | redirect_heredoc          // <<EOF or <<-EOF
    | redirect_output_append    // >>file
    | redirect_output           // >file or N>file
    | redirect_input            // <file
}

redirect_input = { "<" ~ ws* ~ word }
redirect_output = { fd_number? ~ ">" ~ ws* ~ word }
redirect_output_append = { fd_number? ~ ">>" ~ ws* ~ word }
redirect_stderr_to_stdout = { "2>&1" }
redirect_all_output = { "&>" ~ ">"? ~ ws* ~ word }  // &>file or &>>file

// Heredoc: <<EOF or <<-EOF (content collected separately by parser)
redirect_heredoc = { "<<" ~ "-"? ~ ws* ~ heredoc_delimiter }
// Delimiter can be quoted (literal) or unquoted (expand)
heredoc_delimiter = { quoted_string | bare_delimiter }
bare_delimiter = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Herestring: <<<string
redirect_herestring = { "<<<" ~ ws* ~ word }

fd_number = @{ ASCII_DIGIT+ }

// Word: a sequence of word parts (can mix literal text, variables, command substitution)
// Parts are concatenated without whitespace (so "hello$VAR" is one word, "hello $VAR" is two)
word = { word_part+ }

word_part = {
    quoted_string
    | var_expansion
    | arithmetic_expansion
    | command_substitution
    | bare_word_part
}

// Variable expansion: $VAR or ${VAR} or ${VAR:-default} or ${#VAR} or ${VAR#pattern} etc.
var_expansion = {
    "${" ~ "#" ~ var_name ~ "}"  // ${#VAR} - length
    | "${" ~ var_name ~ var_modifier? ~ "}"  // ${VAR} or ${VAR...}
    | "$" ~ var_name  // $VAR
}

var_modifier = {
    ":-" ~ word  // ${VAR:-default}
    | "##" ~ prefix_suffix_pattern  // ${VAR##pattern} - remove longest prefix
    | "#" ~ prefix_suffix_pattern   // ${VAR#pattern} - remove shortest prefix
    | "%%" ~ prefix_suffix_pattern  // ${VAR%%pattern} - remove longest suffix
    | "%" ~ prefix_suffix_pattern   // ${VAR%pattern} - remove shortest suffix
    | "//" ~ replacement_pattern ~ "/" ~ replacement_pattern  // ${VAR//pattern/replacement}
    | "/" ~ replacement_pattern ~ "/" ~ replacement_pattern   // ${VAR/pattern/replacement}
    | ":" ~ var_offset ~ (":" ~ var_length)?  // ${VAR:offset} or ${VAR:offset:length}
    | "^^"  // ${VAR^^} - uppercase all
    | "^"   // ${VAR^} - uppercase first
    | ",,"  // ${VAR,,} - lowercase all
    | ","   // ${VAR,} - lowercase first
}

// Pattern for prefix/suffix removal (can contain /)
prefix_suffix_pattern = @{ (!("}" | NEWLINE) ~ ANY)+ }
// Pattern for replacement (cannot contain / as it's a separator)
replacement_pattern = @{ (!("/" | "}" | NEWLINE) ~ ANY)+ }
var_offset = @{ ("-"? ~ ASCII_DIGIT+) }
var_length = @{ ASCII_DIGIT+ }

// Arithmetic expansion: $((expression))
arithmetic_expansion = { "$((" ~ arithmetic_expr_content ~ "))" }
arithmetic_expr_content = @{ (!("))" | NEWLINE) ~ ANY)* }

// Command substitution: $(command)
command_substitution = { "$(" ~ command_subst_content ~ ")" }
command_subst_content = @{ (!(")" | NEWLINE) ~ ANY)* }

// Reserved keywords that cannot be used as bare words
keyword = { ("if" | "then" | "elif" | "else" | "fi" | "while" | "do" | "done" | "for" | "in" | "case" | "esac") ~ &(ws | NEWLINE | ";" | EOI) }

// Bare word part: literal text (no special characters)
// Note: We exclude $, |, &, <, >, ;, ), } to handle expansion, pipes, operators, redirects, separators, case patterns, and var expansion
// "=" is allowed in words (needed for test command), assignments use explicit var_name pattern
// Keywords are reserved and cannot be used as bare words
bare_word_part = @{ !keyword ~ (!(" " | "\t" | NEWLINE | "#" | "\"" | "'" | "$" | "|" | "&" | "<" | ">" | ";" | ")" | "}") ~ ANY)+ }

// Quoted strings (single quotes prevent expansion, double quotes allow it)
quoted_string = { double_quoted | single_quoted }

// Double quotes: allow variable expansion and command substitution inside
double_quoted = { "\"" ~ double_quoted_content ~ "\"" }
double_quoted_content = { double_quoted_part* }
double_quoted_part = {
    var_expansion
    | arithmetic_expansion
    | command_substitution
    | double_quoted_text
}
double_quoted_text = @{ (!"\"" ~ !"$" ~ ANY)+ }

// Single quotes: no expansion (literal)
single_quoted = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }

NEWLINE = _{ "\n" | "\r\n" }
